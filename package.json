{
  "name": "salty-steak",
  "productName": "Salty Steak",
  "version": "2.0.0",
  "description": "Private offline training and chat desktop software for Salty Steak",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --config app/frontend/vite.config.js --host 127.0.0.1",
    "build": "vite build --config app/frontend/vite.config.js",
    "check:python": ".venv\\Scripts\\python.exe -m compileall -q app",
    "build:desktop": "dotnet build app\\desktop\\native\\SaltyPotatoAI.csproj -c Release",
    "build:browser-host": "dotnet build app\\desktop\\browser\\SaltyBrowser.csproj -c Release",
    "build:uia-host": "dotnet build app\\desktop\\uia\\SaltyUia.csproj -c Release",
    "build:hosts": "npm run build:desktop && npm run build:browser-host && npm run build:uia-host",
    "server": ".venv\\Scripts\\python.exe -m app.backend.server"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
